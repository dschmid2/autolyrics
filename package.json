    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "tailwindcss": "^3.4.10"
  }
}
